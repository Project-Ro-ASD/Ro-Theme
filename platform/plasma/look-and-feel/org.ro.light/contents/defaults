# Ro Light Global Theme defaults. Global Theme seçildiğinde renk, Plasma theme ve Ro splash beraber gelir.

[KSplash]
Engine=KSplashQML
Theme=org.ro.light

[kdeglobals][KDE]
LookAndFeelPackage=org.ro.light
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=RoLight

[plasmarc][Theme]
name=RoLight

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[kwinrc][Plugins]
ro-smooth-motionEnabled=false
kwin4_effect_scaleEnabled=false
kwin4_effect_squashEnabled=false
kwin4_effect_glideEnabled=false
kwin4_effect_magiclampEnabled=false
magiclampEnabled=false
kwin4_effect_windowapertureEnabled=false
kwin4_effect_frozenappEnabled=false
